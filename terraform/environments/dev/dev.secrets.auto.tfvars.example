# Copy to dev.secrets.auto.tfvars. The destination is gitignored.
# Never commit real values. Terraform stores these in encrypted remote state
# and publishes them as standard-tier SSM SecureString parameters.
database_password = "replace-with-current-dev-database-password"

backend_parameter_store_secrets = {
  JWT_SECRET                          = "replace-me"
  EMAIL_ENCRYPTION_KEY                = "replace-me"
  INTERGRATION_ENCRYPTION_KEY         = "replace-me"
  OAUTH_GOOGLE_CLIENT_SECRET          = "replace-me"
  OAUTH_LINKEDIN_CLIENT_SECRET        = "replace-me"
  COUNTRY_STATE_CITY_API_KEY          = "replace-me"
  GOOGLE_APPLICATION_CREDENTIALS_JSON = "replace-with-service-account-json"
}
