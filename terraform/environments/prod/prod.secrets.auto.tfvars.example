# Copy to prod.secrets.auto.tfvars. The destination is gitignored.
# Never commit real values. The production database password is RDS-managed,
# so it does not belong in this file while rotation is enabled.
backend_parameter_store_secrets = {
  JWT_SECRET                          = "replace-me-with-a-production-only-value"
  EMAIL_ENCRYPTION_KEY                = "replace-me-with-a-production-only-value"
  INTERGRATION_ENCRYPTION_KEY         = "replace-me-with-a-production-only-value"
  OAUTH_GOOGLE_CLIENT_SECRET          = "replace-me"
  OAUTH_LINKEDIN_CLIENT_SECRET        = "replace-me"
  COUNTRY_STATE_CITY_API_KEY          = "replace-me"
  GOOGLE_APPLICATION_CREDENTIALS_JSON = "replace-with-service-account-json"
}
